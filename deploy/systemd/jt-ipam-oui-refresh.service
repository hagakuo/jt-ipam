[Unit]
Description=jt-ipam OUI vendor database monthly refresh
After=network-online.target jt-ipam-backend.service
Wants=network-online.target

[Service]
Type=oneshot
User=jtipam
Group=jtipam
WorkingDirectory=/opt/jt-ipam/backend
EnvironmentFile=/etc/jt-ipam/backend.env
ExecStart=/opt/jt-ipam/backend/.venv/bin/python /opt/jt-ipam/scripts/oui_refresh.py
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal
