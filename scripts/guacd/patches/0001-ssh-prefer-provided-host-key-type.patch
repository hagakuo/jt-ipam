+/**
+ * jt-ipam patch: prefers the algorithm of the host key given in the
+ * "host-key" parameter during key exchange.
+ *
+ * libssh2 negotiates its own preferred host key type (ECDSA first). A server
+ * usually has several host keys (RSA, ECDSA, Ed25519), so when the provided
+ * known_hosts entry is for a different type than the one libssh2 picks, the
+ * server presents a key that is not in the entry and verification fails even
+ * though the server is the right one. OpenSSH's client avoids this by
+ * preferring the algorithms of keys it already knows; this does the same.
+ * The other algorithms stay in the list, so a server whose key really changed
+ * still fails with "Host key did not match" rather than a handshake error.
+ *
+ * @param session
+ *     The session to configure, before libssh2_session_handshake().
+ *
+ * @param host_key
+ *     The known_hosts entry: "<host> <key type> <base64 key>".
+ */
+static void guac_common_ssh_prefer_host_key_type(LIBSSH2_SESSION* session,
+        const char* host_key) {
+
+    static const char* defaults[] = {
+        "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521",
+        "ssh-ed25519", "rsa-sha2-512", "rsa-sha2-256", "ssh-rsa", NULL
+    };
+
+    /* Skip the host field, then read the key type */
+    const char* p = host_key;
+    while (*p != '\0' && *p != ' ' && *p != '\t') p++;
+    while (*p == ' ' || *p == '\t') p++;
+    const char* type = p;
+    while (*p != '\0' && *p != ' ' && *p != '\t') p++;
+    size_t len = (size_t) (p - type);
+    if (len == 0 || len > 64)
+        return;
+
+    char key_type[65];
+    memcpy(key_type, type, len);
+    key_type[len] = '\0';
+
+    /* An RSA key can be used with three signature algorithms */
+    const char* first[4] = { key_type, NULL, NULL, NULL };
+    if (strcmp(key_type, "ssh-rsa") == 0) {
+        first[0] = "rsa-sha2-512";
+        first[1] = "rsa-sha2-256";
+        first[2] = "ssh-rsa";
+    }
+
+    char prefs[512] = "";
+    for (int i = 0; first[i] != NULL; i++) {
+        if (prefs[0] != '\0') strncat(prefs, ",", sizeof(prefs) - strlen(prefs) - 1);
+        strncat(prefs, first[i], sizeof(prefs) - strlen(prefs) - 1);
+    }
+    for (int i = 0; defaults[i] != NULL; i++) {
+        int listed = 0;
+        for (int j = 0; first[j] != NULL; j++)
+            if (strcmp(defaults[i], first[j]) == 0) listed = 1;
+        if (!listed) {
+            strncat(prefs, ",", sizeof(prefs) - strlen(prefs) - 1);
+            strncat(prefs, defaults[i], sizeof(prefs) - strlen(prefs) - 1);
+        }
+    }
+
+    /* Unsupported methods are ignored by libssh2 */
+    libssh2_session_method_pref(session, LIBSSH2_METHOD_HOSTKEY, prefs);
+
+}
